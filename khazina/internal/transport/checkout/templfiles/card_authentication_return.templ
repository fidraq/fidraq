package templfiles

import "golang.org/x/text/language"

templ CardAuthenticationReturnPage(lang language.Tag) {
	<!DOCTYPE html>
	<html lang={ lang.String() }>
		<head>
			<title>{ LblCompletingPayment.Get(lang) }</title>
			<style>
				* { margin: 0; padding: 0; box-sizing: border-box; }
				body {
					font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
					display: flex;
					align-items: center;
					justify-content: center;
					min-height: 100vh;
					background: #0f172a;
					color: white;
				}
				.container { text-align: center; padding: 2rem; }
				.spinner {
					width: 48px;
					height: 48px;
					border: 4px solid rgba(255,255,255,0.2);
					border-top-color: white;
					border-radius: 50%;
					animation: spin 0.8s linear infinite;
					margin: 0 auto 1.5rem;
				}
				@keyframes spin { to { transform: rotate(360deg); } }
				h2 { font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem; }
				p { color: #94a3b8; font-size: 0.875rem; }
			</style>
		</head>
		<body>
			<div class="container">
				<div class="spinner"></div>
				<h2>{ LblCompletingPayment.Get(lang) }</h2>
				<p>{ LblPleaseWait.Get(lang) }</p>
			</div>
			<script>
				if (window.parent && window.parent !== window) {
					window.parent.postMessage({
						type: 'CARD_AUTHENTICATION_RETURNED'
					}, window.location.origin);
				}
			</script>
		</body>
	</html>
}
