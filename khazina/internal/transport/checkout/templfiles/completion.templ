package templfiles

import "golang.org/x/text/language"

type CompletionPageData struct {
	Status      string
	Message     string
	CheckoutURL string
	Lang        language.Tag
}

templ CompletionPage(data CompletionPageData) {
	<!DOCTYPE html>
	<html lang={ data.Lang.String() }>
		<head>
			<title>
				if data.Status == "success" {
					{ LblPaymentSuccessful.Get(data.Lang) }
				} else {
					{ LblPaymentFailed.Get(data.Lang) }
				}
			</title>
			<style>
				* { margin: 0; padding: 0; box-sizing: border-box; }
				body {
					font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
					display: flex;
					align-items: center;
					justify-content: center;
					min-height: 100vh;
					background: #0f172a;
					color: white;
				}
				.container { text-align: center; padding: 2rem; }
				.spinner {
					width: 48px;
					height: 48px;
					border: 4px solid rgba(255,255,255,0.2);
					border-top-color: white;
					border-radius: 50%;
					animation: spin 0.8s linear infinite;
					margin: 0 auto 1.5rem;
				}
				@keyframes spin { to { transform: rotate(360deg); } }
				h2 { font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem; }
				p { color: #94a3b8; font-size: 0.875rem; }
			</style>
		</head>
		<body>
			<div class="container">
				<div class="spinner"></div>
				<h2>
					if data.Status == "success" {
						{ LblCompletingPayment.Get(data.Lang) }
					} else {
						{ LblProcessing.Get(data.Lang) }
					}
				</h2>
				<p>{ LblPleaseWait.Get(data.Lang) }</p>
			</div>
			<script>
				(function() {
					var status = {{ data.Status }};
					var message = {{ data.Message }};
					var checkoutURL = {{ data.CheckoutURL }};

					if (window.parent && window.parent !== window) {
						window.parent.postMessage({
							type: '3DS_COMPLETE',
							status: status,
							message: message
						}, '*');
					}

					setTimeout(function() {
						window.top.location.href = checkoutURL;
					}, 3000);
				})();
			</script>
		</body>
	</html>
}
