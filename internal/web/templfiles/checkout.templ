package templfiles

templ CheckoutPage(mpgsBaseURL, mpgsAPIVersion, mpgsMerchantID, sessionID, pid string) {
	<!DOCTYPE html>
	<html>
		<head>
			<title>Checkout Page :D</title>
			<style id="antiClickjack">body{display:none !important;}</style>
			<!-- Helper class for the silent iframe -->
			<style> .hidden-frame { width: 0; height: 0; border: 0; display: none; } </style>
			<script src={ mpgsBaseURL + "/form/version/" + mpgsAPIVersion + "/merchant/" + mpgsMerchantID + "/session.js" }></script>
			<!-- <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script> -->
		</head>
		<body>
			<div id="paymentUI">
				<div>
					Please enter your payment details:
				</div>
				<h3>
					Credit Card
				</h3>
				<div>
					Card Number:
					<input
						type="text"
						id="card-number"
						class="input-field"
						title="card number"
						aria-label="enter your card number"
						value=""
						tabindex="1"
						readonly
					/>
				</div>
				<div>
					Expiry Month:
					<input
						type="text"
						id="expiry-month"
						class="input-field"
						title="expiry month"
						aria-label="two digit expiry month"
						value=""
						tabindex="2"
						readonly
					/>
				</div>
				<div>
					Expiry Year:
					<input
						type="text"
						id="expiry-year"
						class="input-field"
						title="expiry year"
						aria-label="two digit expiry year"
						value=""
						tabindex="3"
						readonly
					/>
				</div>
				<div>
					Security Code:
					<input
						type="text"
						id="security-code"
						class="input-field"
						title="security code"
						aria-label="three digit CCV security code"
						value=""
						tabindex="4"
						readonly
					/>
				</div>
				<div>
					Cardholder Name:
					<input
						type="text"
						id="cardholder-name"
						class="input-field"
						title="cardholder name"
						aria-label="enter name on card"
						value=""
						tabindex="5"
						readonly
					/>
				</div>
				<div>
					<button id="payButton" onclick="pay();">
						Pay Now
					</button>
				</div>
			</div>
			<!-- 3DS Method (Silent Iframe) Container -->
			<div id="method-container"></div>
			<!-- 3DS Challenge (Visible Iframe) Container -->
			<div id="challenge-container"></div>
			<script type="text/javascript">
// Anti-clickjack protection
if (self === top) {
  var antiClickjack = document.getElementById("antiClickjack");
  antiClickjack.parentNode.removeChild(antiClickjack);
} else {
  top.location = self.location;
}

// Global variables from backend
const SESSION_ID = {{ sessionID }};
const PID = {{ pid }};

// Configure Payment Session
PaymentSession.configure({
  session: SESSION_ID,
  fields: {
    card: {
      number: "#card-number",
      securityCode: "#security-code",
      expiryMonth: "#expiry-month",
      expiryYear: "#expiry-year",
      nameOnCard: "#cardholder-name"
    }
  },
  frameEmbeddingMitigation: ["javascript"],
  callbacks: {
    initialized: function(response) {
      // Handle initialization if needed
    },
    formSessionUpdate: function(response) {
      if (response.status === "ok") {
        console.log("Session updated. Starting 3DS Flow...");
        startPaymentFlow(SESSION_ID);
      } else {
        console.log("Session update failed: " + response.status);
      }
    }
  },
  interaction: {
    displayControl: {
      formatCard: "EMBOSSED",
      invalidFieldCharacters: "REJECT"
    }
  }
});

function pay() {
  PaymentSession.updateSessionFromForm('card');
}

// Get browser details for 3DS
function getBrowserDetails() {
  const w = window.screen.width;
  const h = window.screen.height;
  let windowSize = "250_X_400";
  if (w >= 600 && h >= 400) windowSize = "FULL_SCREEN";
  else if (w >= 500 && h >= 600) windowSize = "500_X_600";
  else if (w >= 390 && h >= 400) windowSize = "390_X_400";
  
  return {
    "3DSecureChallengeWindowSize": windowSize,
    "acceptHeaders": "*/*",
    "colorDepth": window.screen.colorDepth,
    "javaEnabled": navigator.javaEnabled ? navigator.javaEnabled() : false,
    "language": navigator.language,
    "screenHeight": window.screen.height,
    "screenWidth": window.screen.width,
    "timeZone": -new Date().getTimezoneOffset()
  };
}

async function startPaymentFlow(sessionId) {
  const initRes = await fetch("/checkout/" + PID + "/initiate-auth/" + sessionId, {
    method: "POST",
    body: JSON.stringify({ sessionId: sessionId })
  }).then(r => r.json());

  if (initRes.next_step === "authenticate") {
    doAuthenticatePayer(sessionId, initRes.tx_id);
  } else if (initRes.next_step === "another_payment_method") {
    console.log("Try another payment method");
  } else if (initRes.next_step === "cant_continue") {
    console.log("Cannot continue with payment");
  }
}

async function doAuthenticatePayer(sessionId, txId) {
  const authRes = await fetch("/checkout/" + PID + "/process-auth/" + sessionId + "/" + txId, {
    method: "POST",
    body: JSON.stringify(getBrowserDetails())
  }).then(r => r.json());

  if (authRes.next_step === "3ds_challenge") {
        console.log("3DS Challenge required");
    
    // Inject the HTML
    const tempDiv = document.createElement('div');
    tempDiv.innerHTML = authRes.redirect_html;
    document.body.appendChild(tempDiv);
    
    // Execute the script to auto-submit the form
    const script = document.getElementById('authenticate-payer-script');
    if (script) {
        eval(script.text);
    }
    
    // Hide payment UI
    document.getElementById("paymentUI").style.display = 'none';
  } else if (authRes.next_step === "pay") {
    console.log("Ready to pay");
    // TODO: Call payment endpoint
  } else if (authRes.next_step === "another_payment_method") {
    console.log("Try another payment method");
  } else if (authRes.next_step === "cant_continue") {
    console.log("Cannot continue with payment");
  }
}
</script>
		</body>
	</html>
}
