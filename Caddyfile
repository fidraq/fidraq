{
	email {$ACME_EMAIL}

	on_demand_tls {
		ask http://saftaja:8080/verify-domain?secret={$VERIFY_DOMAIN_SECRET}
		interval 5m
		burst 5
	}
}

# Main domain
{$BASE_DOMAIN} {
	reverse_proxy saftaja:8080
}

# Custom merchant domains (on-demand TLS)
:443 {
	tls {
		on_demand
	}
	reverse_proxy saftaja:8080
}

# HTTP redirect
:80 {
	redir https://{host}{uri} permanent
}
