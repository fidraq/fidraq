{
	email {$ACME_EMAIL}

	on_demand_tls {
		ask http://khazina:8080/verify-domain?secret={$VERIFY_DOMAIN_SECRET}
		interval 5m
		burst 5
	}
}

# Landing page
{$BASE_DOMAIN} {
	root * /srv/bawaba
	file_server
}

# Dashboard
app.{$BASE_DOMAIN} {
	root * /srv/diwan
	file_server
	try_files {path} /index.html
}

# Backend API + checkout
khazina.{$BASE_DOMAIN} {
	reverse_proxy khazina:8080
}

# Custom merchant domains (on-demand TLS)
:443 {
	tls {
		on_demand
	}
	reverse_proxy khazina:8080
}

# HTTP redirect
:80 {
	redir https://{host}{uri} permanent
}
