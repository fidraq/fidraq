:80 {
	root * /srv

	# Runtime config, so one image works with any API URL.
	handle /config.js {
		header Content-Type "text/javascript; charset=utf-8"
		header Cache-Control "no-store"
		respond `window.__FIDRAQ_CONFIG__ = { apiUrl: "{$API_URL}" };` 200
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
